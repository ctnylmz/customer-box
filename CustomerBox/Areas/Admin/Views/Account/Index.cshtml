<div class="container">

    @if (TempData["Message"] != null)
    {
        <div id="successMessage" class="alert alert-success fw-semibold my-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Message"]
        </div>
    }

    <div class="card mt-4">
        <div class="card-header bg-primary text-white py-3">
            <h6 class="mb-0">Kullanıcı Ayarları</h6>
        </div>

        <div class="card-body">

            <form method="post">

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label class="form-label">Kullanıcı Adı</label>

                    <input type="text"
                           name="newUsername"
                           value="@ViewBag.Username"
                           class="form-control"
                           placeholder="Yeni kullanıcı adınızı girin" />
                </div>
                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-4">
                    <a asp-controller="Default" asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>

                    <button type="submit" class="btn btn-warning text-white px-4">
                        Update
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>


<script>
    setTimeout(() => {
        const message = document.getElementById('successMessage');
        if (message) {
            message.classList.add('fade');
            message.classList.remove('show');
            setTimeout(() => message.remove(), 500);
        }
    }, 7000);
</script>